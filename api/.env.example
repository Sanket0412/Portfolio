# Copy to api/.env (gitignored) and fill in. Do NOT commit real secrets.

# --- LLM provider ---
# Which provider the agent uses by default: "openai" or "anthropic"
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.4

# --- Embeddings (pin the dim to match pgvector column) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Supabase Postgres + pgvector ---
# Use the SESSION POOLER connection string from the Supabase dashboard
# (Connect -> Session pooler). It is IPv4-friendly, supports prepared
# statements, and supports DDL like CREATE EXTENSION. The DIRECT connection
# is IPv6-only by default and the TRANSACTION pooler (port 6543) disallows
# prepared statements -- both are the wrong choice for this app.
#
# Username is `postgres.<PROJECT_REF>` (with the dot), supplied by Supabase
# when you copy from the Session pooler tab. The app adds the +psycopg
# driver suffix internally, so paste the postgresql:// URL as-is.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
PGVECTOR_COLLECTION=portfolio

# --- Optional (Phase 2 tools) ---
# GitHub repo-lookup tool. Token is optional (raises the API rate limit from 60 to
# 5000 req/hr); username defaults to Sanket0412 if unset.
GITHUB_TOKEN=
GITHUB_USERNAME=Sanket0412

# --- FastAPI ---
APP_ENV=development
CORS_ORIGINS=*
